# ------------------------------------------------------------------------------
# Backend .gitignore
# ------------------------------------------------------------------------------

# Environment variables
.env
.env.*
*.env
!.env.example

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Virtual Environment
.venv/
venv/
env/

# Pytest & linting
.pytest_cache/
.coverage
.coverage.*
.ruff_cache/
.mypy_cache/

# Local data & logs
*.log
logs/
uploads/
temp/
scratch/
*.db
*.sqlite3

# IDE
.vscode/
.idea/
.DS_Store
Thumbs.db
